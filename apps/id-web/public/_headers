# Security headers for id-web (RPID SSO UI) — issue #675 P2 bug sweep.
# Format: Cloudflare Workers Assets `_headers` (per-path rules), modeled on
# apps/www/_headers. Vite's default publicDir copies this into dist/, and
# cf-deploy-app.yml copies dist/ -> apps/id-api/public (the Worker assets
# dir) at deploy time — see apps/id-api/wrangler.toml [assets].
#
# Verify in production with:
#   curl -sI https://id.rallypt.app/ | grep -iE 'strict|frame|content-type-opt|referrer|content-security'

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # id-web talks to id-api same-origin at /api/v1/ui/* (apps/id-web/src/api/client.ts
  # uses apiBase ?? '' -> relative fetches), so connect-src is 'self' plus the
  # analytics hosts (PostHog via the t.rallypt.app reverse proxy). Turnstile
  # (apps/id-web/src/ui/Turnstile.tsx) loads its widget script from
  # challenges.cloudflare.com and that script itself makes XHR/fetch calls back
  # to the same host, so both script-src and connect-src need it; the widget is
  # rendered in an iframe, so frame-src needs it too.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://t.rallypt.app https://static.cloudflareinsights.com 'sha256-gopMjDnBwg9lxgEEjjCKPvnGp9H5dUVpXCM2gHFbW1k=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://t.rallypt.app https://cloudflareinsights.com https://us.i.posthog.com https://*.i.posthog.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
