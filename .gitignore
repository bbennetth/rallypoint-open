node_modules/
dist/
build/
.next/
.turbo/
.cache/
coverage/

# env files (never commit)
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# ad-hoc spike / debug scripts at repo root (keep docs/screenshots/*.mjs)
/*.mjs

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# claude-local workflow scratch (gitignored per CLAUDE.md)
CHANGELOG_PENDING.md
# machine-local Claude Code runtime state (process lock + agent worktrees)
.claude/scheduled_tasks.lock
.claude/worktrees/

# build artifacts
*.tsbuildinfo

# wrangler / miniflare local state (local D1, caches) — never commit
.wrangler/
# wrangler local dev secrets — never commit
.dev.vars
**/.dev.vars
# generated CF_WORKER_SECRETS JSON (scripts/gen-cf-secrets.sh) — never commit
cf-worker-secrets.json

# playwright (we never want browsers committed; ad-hoc tests are dev-time only)
.playwright-cache/
test-results/
playwright-report/
# saved E2E auth sessions contain real session cookies — never commit
e2e/.auth/

# Worker [assets] dirs (apps/<api>/public) get wiped + repopulated from
# the per-app <web>/dist at deploy time (cf-deploy.yml's matrix job:
# `rm -rf apps/<app>/public && cp -r <web_dist> apps/<app>/public`). The
# placeholder index.html is the only thing tracked so `wrangler dev`
# works pre-build; everything else (sw.js, sw.js.map, registerSW.js,
# manifest.webmanifest, assets/, icons/) is vite-plugin-pwa build
# output that lives transiently. Audit E4 O1: stop these from
# polluting `git status` and prevent accidental commits.
apps/*-api/public/*
!apps/*-api/public/index.html
